# Copy to .env and fill in. Never commit .env.
# The sponsor keys all come from /costar-keys in the #costar-group Discord channel.
# Generating them accepts the CoStar event terms: read those first.

# Matterport Model API (GraphQL). The key is the user name, the token is the password.
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
# Only needed if we embed the 3D tour with the Showcase SDK
MATTERPORT_SDK_KEY=

# Vexcel aerial data (Houston and Los Angeles only)
VEXCEL_API_KEY=

# CoStar kit: the zip password, plus the downloaded zip (or its download link)
COSTAR_ZIP_PASSWORD=
COSTAR_KIT_ZIP=data/raw/costar-kit.zip
COSTAR_KIT_URL=

# LLM for the agent, "provider:model". Install the provider package and set its key, for example:
#   google_genai:<model id>       pip install langchain-google-genai   GOOGLE_API_KEY=...
#   bedrock_converse:<model id>   pip install langchain-aws            AWS credentials
#   anthropic:<model id>          pip install langchain-anthropic      ANTHROPIC_API_KEY=...
LIGHTS_ON_MODEL=
